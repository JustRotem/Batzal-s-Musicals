generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  firstName      String
  lastName       String
  username       String    @unique
  email          String    @unique
  googleSubject  String?   @unique
  phone          String?
  phoneVerified  Boolean   @default(false)
  phoneVerificationCodeHash String?
  phoneVerificationExpires  DateTime?
  emailVerified  Boolean   @default(true)
  emailVerificationTokenHash String?
  emailVerificationExpires   DateTime?
  emailVerificationSentAt    DateTime?
  passwordResetTokenHash     String?
  passwordResetExpires       DateTime?
  passwordResetSentAt        DateTime?
  passwordHash   String
  avatarUrl      String?
  requestMessage String?
  language       String    @default("he")
  theme          String?

  status UserStatus @default(active)
  role   UserRole   @default(user)

  sessions  Session[]
  userPermissions UserPermission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdMusicals Musical[] @relation("MusicalCreatedBy")
  updatedMusicals Musical[] @relation("MusicalUpdatedBy")
  createdClips      Clip[]    @relation("ClipCreatedBy")
  updatedClips      Clip[]    @relation("ClipUpdatedBy")
  comments          Comment[]
  moderatedComments Comment[] @relation("CommentModeratedBy")
  commentReactions  CommentReaction[]
  notifications     Notification[]
  gameScores        GameScore[]
  qrHistory         QrHistory[]
  submittedCommentReports CommentReport[] @relation("CommentReportReporter")
  reviewedCommentReports  CommentReport[] @relation("CommentReportReviewedBy")
}

enum UserRole {
  user
  editor
  admin
  superadmin
}

enum UserStatus {
  active
  pending
  blocked
}

enum PermissionName {
  musical_view
  musical_create
  musical_edit
  musical_delete
  clip_view
  clip_create
  clip_edit
  clip_delete
  user_view
  user_manage
  role_manage
  editor_request_review
  profile_edit
  panel_view
  panel_control
  panel_people
}

model Permission {
  id String @id @default(cuid())
  name PermissionName @unique

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  id String @id @default(cuid())

  role UserRole

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([permissionId])
}

model UserPermission {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([permissionId])
}

model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?

  // One browser signed in to several Batzal sites: the account session and the sessions it created elsewhere share this id,
  // so signing out anywhere signs out everywhere.
  ssoGroup     String?

  // Set when the person signed in with Google again to confirm it is really them (sensitive changes in the control panel)
  confirmedUntil DateTime?

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([ssoGroup])
}

model Musical {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String?

  year         Int?
  production   String?
  thumbnailUrl String?
  imagePath    String?
  posterDisplayMode PosterDisplayMode @default(crop)
  posterAspect PosterAspect @default(square)
  emoji        String?

  // The section of the library this item belongs to (musicals, the friends group, ...)
  categoryId   String?
  category     LibraryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  isPublished  Boolean  @default(false)
  sortOrder    Int      @default(0)

  createdById  String?
  updatedById  String?

  createdBy    User?    @relation("MusicalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?    @relation("MusicalUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clips        Clip[]

  @@index([categoryId])
}

// A section of the library. Editors create and rename them, so the library can hold more than musicals.
model LibraryCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameHe    String
  nameEn    String
  emoji     String?
  sortOrder Int      @default(0)

  items     Musical[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PosterDisplayMode {
  crop
  fit
}

enum PosterAspect {
  square
  wide
  tall
}

enum ClipSourceType {
  youtube
  upload
}

enum CommentStatus {
  visible
  hidden
}

enum CommentReportReason {
  spam
  abusive
  irrelevant
  other
}

enum CommentReportStatus {
  open
  reviewed
  dismissed
  actioned
}

model Clip {
  id String @id @default(cuid())

  title       String
  description String?

  sourceType ClipSourceType @default(youtube)

  youtubeVideoId   String?
  uploadedVideoUrl String?
  uploadedThumbnailUrl String?

  startSeconds Int  @default(0)
  endSeconds   Int?

  sortOrder Int @default(0)

  // A draft is visible only to people who manage the library
  isDraft   Boolean @default(false)

  musicalId String
  musical   Musical @relation(fields: [musicalId], references: [id], onDelete: Cascade)

  createdById String?
  updatedById String?

  createdBy User? @relation("ClipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("ClipUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]
}

model Comment {
  id String @id @default(cuid())

  clipId String
  clip   Clip   @relation(fields: [clipId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  content String
  status  CommentStatus @default(visible)

  hiddenAt DateTime?
  moderatedAt DateTime?

  moderatedById String?
  reactions     CommentReaction[]
  moderatedBy   User? @relation("CommentModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)
  reports       CommentReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clipId, status, createdAt])
  @@index([userId, createdAt])
  @@index([moderatedById])
}

model CommentReport {
  id String @id @default(cuid())

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reporterUserId String
  reporterUser   User @relation("CommentReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)

  reason  CommentReportReason
  details String?
  status  CommentReportStatus @default(open)

  reviewedAt DateTime?

  reviewedById String?
  reviewedBy   User? @relation("CommentReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commentId, status, createdAt])
  @@index([reporterUserId, status, createdAt])
  @@index([reviewedById])
}

// One person can add each emoji to a comment once; adding it again removes it.
model CommentReaction {
  id        String   @id @default(cuid())
  emoji     String

  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId, emoji])
  @@index([commentId])
}

// A message for one person, shown in the bell of every Batzal site. Both languages are stored; the reader gets theirs.
model Notification {
  id        String    @id @default(cuid())
  kind      String
  titleHe   String
  titleEn   String
  bodyHe    String?
  bodyEn    String?
  href      String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Best result of a person in one of the small games on the Batzal home page.
model GameScore {
  id        String   @id @default(cuid())
  game      String
  score     Int
  updatedAt DateTime @default(now()) @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, game])
  @@index([game, score])
}

// A QR code someone made on qr.batzal.net: the link, the centre image (a small data URL) and its size.
model QrHistory {
  id        String   @id @default(cuid())
  url       String
  logoSize  Int      @default(30)
  logo      String?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
