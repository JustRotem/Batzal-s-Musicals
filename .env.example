DATABASE_URL="postgresql://postgres:postgres@postgres:5432/musicals?schema=public"
APP_URL="https://musicals.batzal.net"
NEXT_PUBLIC_APP_URL="https://musicals.batzal.net"
NEXT_PUBLIC_APP_TITLE_HE="ספריית הבצל"
NEXT_PUBLIC_APP_TITLE_EN="Batzal's Library"

# Use a dedicated non-proxied upload origin so larger clip-video POST requests do not go through the main proxied app domain.
CLIP_UPLOAD_BASE_URL="https://upload.batzal.net"
# Sign short-lived upload tokens exchanged between the main app origin and the upload origin.
CLIP_UPLOAD_AUTH_SECRET="replace-this-with-a-long-random-secret"

FROM_EMAIL_NAME="Batzal's Musicals"
FROM_EMAIL="no-reply@batzal.net"
RESEND_API_KEY="your-resend-api-key"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Two sites run from this code: APP_MODE=musicals (default) and APP_MODE=account (sign-in, settings, users, permissions).
APP_MODE="musicals"
ACCOUNT_URL="https://account.batzal.net"
# Public key of the account site (musicals and other sites verify sign-in tokens with it).
# SSO_PUBLIC_KEY=""
# Single sign-on. The account site signs tokens (set the private key there only). Generate with: node scripts/generate-sso-key.mjs
SSO_PRIVATE_KEY=""
# Comma-separated origins allowed to receive sign-in tokens (default: https://qr.batzal.net,https://admin.batzal.net)
# SSO_ALLOWED_ORIGINS=""
