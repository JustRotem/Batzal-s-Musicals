DATABASE_URL="postgresql://postgres:postgres@postgres:5432/musicals?schema=public"
APP_URL="https://musicals.batzal.net"
NEXT_PUBLIC_APP_URL="https://musicals.batzal.net"
# Use a dedicated non-proxied upload origin so larger clip-video POST requests do not go through the main proxied app domain.
CLIP_UPLOAD_BASE_URL="https://upload.batzal.net"
# Sign short-lived upload tokens exchanged between the main app origin and the upload origin.
CLIP_UPLOAD_AUTH_SECRET="replace-this-with-a-long-random-secret"

FROM_EMAIL_NAME="Batzal's Musicals"
FROM_EMAIL="no-reply@batzal.net"
RESEND_API_KEY="your-resend-api-key"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
TURNSTILE_SITE_KEY="0x4AAAA..."
TURNSTILE_SECRET_KEY="0x4AAAA..."
